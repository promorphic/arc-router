# Copy to .env and fill in. Never commit .env. Testnet values only.

# --- Networks (public RPCs; override if you have your own) ---
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Circle developer account (Console -> Keys -> Create a key -> API key -> Standard Key) ---
# Must be a TESTNET key. Format: TEST_API_KEY:<key id>:<secret>
CIRCLE_API_KEY=
# Console -> Wallets -> User Controlled -> Configurator
CIRCLE_APP_ID=

# --- Test wallets (faucet funds only) ---
# Source-side wallet for the CCTP demo: stands in for the customer's funding wallet on Sepolia.
# TEST WALLET. Faucet funds only. Never reuse a key that has held real funds.
TEST_SOURCE_PRIVATE_KEY=
# Address of the customer's Circle user-controlled wallet on Arc testnet (destination of 1a).
ARC_USER_WALLET_ADDRESS=
# Address of the Circle Agent Wallet on Arc testnet (created with the Circle CLI; see docs/notes.md).
ARC_AGENT_WALLET_ADDRESS=

# --- Dinari (M2; sandbox only until an explicit mainnet go) ---
DINARI_API_KEY_ID=
DINARI_API_SECRET=
DINARI_ENV=sandbox
